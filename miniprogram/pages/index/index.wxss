.page {
  padding: 32rpx 32rpx 160rpx;
}

.header {
  padding: 24rpx 8rpx 40rpx;
}
.header-title {
  font-size: 48rpx;
  font-weight: 700;
}
.header-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--text-3);
}

.device-card {
  display: flex;
  align-items: center;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
}
.device-card:active { transform: scale(0.985); }

.device-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.device-info { flex: 1; min-width: 0; }

.device-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.device-name {
  font-size: 32rpx;
  font-weight: 600;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.wake-btn {
  flex-shrink: 0;
  padding: 16rpx 28rpx;
  border-radius: 20rpx;
  background: var(--primary);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}
.wake-btn:active { opacity: 0.8; }

.chevron {
  color: #d1d5db;
  font-size: 44rpx;
  padding: 0 8rpx;
}

.fab {
  position: fixed;
  right: 48rpx;
  bottom: 80rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  font-size: 56rpx;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(79, 110, 247, 0.4);
}
.fab:active { transform: scale(0.92); }
