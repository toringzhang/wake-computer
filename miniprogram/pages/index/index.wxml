<view class="page">
  <view class="header">
    <view class="header-title">我的设备</view>
    <view class="header-sub">局域网唤醒与远程控制</view>
  </view>

  <block wx:if="{{devices.length}}">
    <view
      wx:for="{{devices}}"
      wx:key="id"
      class="card device-card"
      bindtap="goDevice"
      data-id="{{item.id}}"
    >
      <view class="device-icon">💻</view>
      <view class="device-info">
        <view class="device-name-row">
          <text class="device-name">{{item.name}}</text>
          <view class="tag {{item.status === 'online' ? 'tag-online' : item.status === 'offline' ? 'tag-offline' : 'tag-unknown'}}">
            <view class="dot {{item.status === 'online' ? 'dot-online' : item.status === 'offline' ? 'dot-offline' : 'dot-unknown'}}"></view>
            {{item.status === 'online' ? '在线' : item.status === 'offline' ? '离线' : '检测中'}}
          </view>
        </view>
        <view class="device-meta">{{item.host}} · {{item.appCount}} 个应用</view>
      </view>
      <view
        wx:if="{{item.status !== 'online'}}"
        class="wake-btn"
        catchtap="quickWake"
        data-id="{{item.id}}"
      >⚡ 唤醒</view>
      <view wx:else class="chevron">›</view>
    </view>
  </block>

  <view wx:else class="empty">
    <view class="empty-icon">🖥️</view>
    <view class="empty-text">还没有添加设备</view>
    <view class="empty-sub">点击下方按钮添加你的第一台电脑</view>
  </view>

  <view class="fab" bindtap="goAdd">＋</view>
</view>
