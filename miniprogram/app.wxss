/* 全局设计体系：简洁现代风 */
page {
  --bg: #f5f6fa;
  --card: #ffffff;
  --text: #1a1d26;
  --text-2: #6b7280;
  --text-3: #9ca3af;
  --primary: #4f6ef7;
  --primary-soft: #eef1fe;
  --danger: #ef4444;
  --danger-soft: #fef2f2;
  --success: #10b981;
  --success-soft: #ecfdf5;
  --warning: #f59e0b;
  --radius: 28rpx;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, 'SF Pro', 'PingFang SC', 'HarmonyOS Sans', sans-serif;
  font-size: 28rpx;
}

.card {
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: 0 2rpx 16rpx rgba(26, 29, 38, 0.04);
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  transition: opacity 0.15s;
}
.btn:active { opacity: 0.75; }
.btn-primary { background: var(--primary); color: #fff; }
.btn-soft { background: var(--primary-soft); color: var(--primary); }
.btn-danger-soft { background: var(--danger-soft); color: var(--danger); }
.btn-ghost { background: transparent; color: var(--text-2); border: 2rpx solid #e5e7eb; }
.btn[disabled], .btn.disabled { opacity: 0.45; pointer-events: none; }

.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}
.tag-online { background: var(--success-soft); color: var(--success); }
.tag-offline { background: #f3f4f6; color: var(--text-3); }
.tag-unknown { background: #fffbeb; color: var(--warning); }

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}
.dot-online { background: var(--success); }
.dot-offline { background: #d1d5db; }
.dot-unknown { background: var(--warning); }

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0 80rpx;
  color: var(--text-3);
}
.empty-icon { font-size: 96rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 28rpx; }
.empty-sub { font-size: 24rpx; margin-top: 12rpx; color: #c4c8d0; }
